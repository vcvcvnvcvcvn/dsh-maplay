{
  "name": "dsh-maplay",
  "version": "0.1.0",
  "description": "dsh plugin: drive the maplay 2D map animation playground from a DeepSeek Harness agent. Everything-is-a-plugin: tools, embedded web view, and maplay server lifecycle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools-preset": {
      "types": "./lib/tools-preset.d.ts",
      "default": "./lib/tools-preset.js"
    },
    "./client": "./browser.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "react"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "browser.js",
    "cordis.yml",
    "cordis.headless.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "maplay",
    "map",
    "animation",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcvcvnvcvcvn/dsh-maplay.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@vcvcvn/maplay": "github:vcvcvnvcvcvn/maplay"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.0.1-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.0.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.5",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "0.0.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  }
}
